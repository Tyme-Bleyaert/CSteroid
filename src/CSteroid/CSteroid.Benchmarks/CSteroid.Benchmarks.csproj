<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />

    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSteroid.Core\CSteroid.Core.csproj" />
    <ProjectReference Include="..\CSteroid.AutoMediator\CSteroid.AutoMediator.csproj" />
    <ProjectReference Include="..\CSteroid.Generator\CSteroid.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Mapping\CSteroid.Generator.Mapping.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Validation\CSteroid.Generator.Validation.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Reference Include="..\CSteroid.Generator.AutoMediator\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.AutoMediator.dll" />
    <Reference Include="..\CSteroid.Generator.Shared\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Shared.dll" />
    <!-- Build-order only: raw references keep the benchmark itself from running AutoMediator generation. -->
    <ProjectReference Include="..\CSteroid.Generator.AutoMediator\CSteroid.Generator.AutoMediator.csproj" ReferenceOutputAssembly="false" />
    <!-- Analyzer dependency: Roslyn resolves CSteroid.Generator.Shared.dll from the additional analyzer path. -->
    <ProjectReference Include="..\CSteroid.Generator.Shared\CSteroid.Generator.Shared.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
