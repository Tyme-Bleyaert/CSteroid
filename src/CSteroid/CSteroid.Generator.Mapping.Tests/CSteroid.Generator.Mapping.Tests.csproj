<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSteroid.Core\CSteroid.Core.csproj" />
    <ProjectReference Include="..\CSteroid.Generator.Testing\CSteroid.Generator.Testing.csproj" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Mapping\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Mapping.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Validation\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Validation.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.EFCore\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.EFCore.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Dapper\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Dapper.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.CosmosDB\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.CosmosDB.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.MongoDB\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.MongoDB.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.PostgreSQL\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.PostgreSQL.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Shared\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Shared.dll" />
    <!-- Build-order only: the raw Reference paths above do not create project dependencies. -->
    <ProjectReference Include="..\CSteroid.Generator\CSteroid.Generator.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Mapping\CSteroid.Generator.Mapping.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Validation\CSteroid.Generator.Validation.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.EFCore\CSteroid.Generator.EFCore.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Dapper\CSteroid.Generator.Dapper.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.CosmosDB\CSteroid.Generator.CosmosDB.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.MongoDB\CSteroid.Generator.MongoDB.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.PostgreSQL\CSteroid.Generator.PostgreSQL.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Shared\CSteroid.Generator.Shared.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
