<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Description>Blazor EditContext integration for CSteroid custom validation.</Description>
    <PackageTags>csteroid blazor editcontext validation forms</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSteroid.Core\CSteroid.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="8.0.22" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.9" />
  </ItemGroup>

</Project>
