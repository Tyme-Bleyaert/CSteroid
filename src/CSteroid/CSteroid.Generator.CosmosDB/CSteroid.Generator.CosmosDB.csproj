<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Emit this project as an analyzer (so it will be consumed as a source generator) -->
    <OutputItemType>Analyzer</OutputItemType>
    <!-- Don't include the build output as a regular reference when this project is referenced -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Make the project packable so it can be produced as a NuGet package containing the generator -->
    <IsPackable>true</IsPackable>
    <Description>CSteroid Cosmos DB model generator: emits complete models for [OrmTarget(CosmosDB)] interfaces (source generator).</Description>
    <PackageTags>csteroid source-generator roslyn models mapping validation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn APIs needed for incremental generators. Marked PrivateAssets so they don't flow to consumers. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSteroid.Core\CSteroid.Core.csproj" />
    <ProjectReference Include="..\CSteroid.Orm\CSteroid.Orm.csproj" />
    <ProjectReference Include="..\CSteroid.Generator.Shared\CSteroid.Generator.Shared.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
