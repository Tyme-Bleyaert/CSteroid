<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSteroid.Medium\CSteroid.Medium.csproj" />

    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Medium\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Medium.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Shared\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Shared.dll" />
    <Reference Include="$(MSBuildThisFileDirectory)..\CSteroid.Generator.Medium.CodeFixes\bin\$(Configuration)\netstandard2.0\CSteroid.Generator.Medium.CodeFixes.dll" />
    <!-- Build-order only: the raw Reference paths above do not create project dependencies. -->
    <ProjectReference Include="..\CSteroid.Generator.Medium\CSteroid.Generator.Medium.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Shared\CSteroid.Generator.Shared.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSteroid.Generator.Medium.CodeFixes\CSteroid.Generator.Medium.CodeFixes.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
